# 텍스트 파일 (사람 11-12): 저장소 안은 LF · 꺼낼 때 OS 줄끝(bat·cmd 는 CRLF 고정 — cmd.exe 가 LF 만이면 UTF-8 줄을 잘못 읽음)
# 인코딩은 전부 UTF-8 BOM 없음 — git 은 인코딩을 바꾸지 않으므로 쓰는 쪽이 지킨다(working-tree-encoding 안 씀). 아래 LFS 줄이 이 규칙을 덮어씀
* text=auto
*.cpp text
*.h text
*.hpp text
*.cs text
*.json text
*.md text
*.ini text
*.txt text
*.py text
*.uproject text
*.uplugin text
*.bat text eol=crlf
*.cmd text eol=crlf

# 큰 이진 파일은 Git LFS
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap   filter=lfs diff=lfs merge=lfs -text
*.png    filter=lfs diff=lfs merge=lfs -text
*.jpg    filter=lfs diff=lfs merge=lfs -text
*.tga    filter=lfs diff=lfs merge=lfs -text
*.exr    filter=lfs diff=lfs merge=lfs -text
*.wav    filter=lfs diff=lfs merge=lfs -text
*.ogg    filter=lfs diff=lfs merge=lfs -text
*.fbx    filter=lfs diff=lfs merge=lfs -text
*.blend  filter=lfs diff=lfs merge=lfs -text
*.ttf    filter=lfs diff=lfs merge=lfs -text
*.otf    filter=lfs diff=lfs merge=lfs -text
*.glb    filter=lfs diff=lfs merge=lfs -text
*.gltf   filter=lfs diff=lfs merge=lfs -text
*.webp   filter=lfs diff=lfs merge=lfs -text
*.bank   filter=lfs diff=lfs merge=lfs -text

# 자동 시험 고정 파일(아주 작음)은 LFS 밖 — LFS 없이도 시험이 돈다
Source/Historia/Tests/Fixtures/**/*.png -filter -diff -merge -text

# 지형 만들기 도구가 쓴 terrain.json 은 바이트 그대로 (같은 spec = 같은 파일 비교)
Scenarios/**/terrain.json -text

# 받아 온 원본 텍스처 (Poly Haven CC0 — Tools/hmb_materials.bat 이 받음)
SourceArt/**/*.jpg filter=lfs diff=lfs merge=lfs -text

# 지형 편집기·작업실이 쓴 terrain.json 도 바이트 그대로 (저장 → 읽기 → 저장 = 같은 바이트)
Terrains/**/terrain.json -text
*.mp4    filter=lfs diff=lfs merge=lfs -text
SourceArt/**/*.jpeg filter=lfs diff=lfs merge=lfs -text

# 거시 core 바깥 소스 고정 — 바이트 그대로 (VERSIONS.json 의 sha256 이 어느 clone 에서도 맞게, 줄끝 바꾸지 않음)
ThirdParty/HisDeps/** -text

# git 훅 (sh) — 줄 끝 LF 고정
Tools/hooks/git/* text eol=lf
